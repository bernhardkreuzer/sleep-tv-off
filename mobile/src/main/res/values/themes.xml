<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dunkler Grund (Tinte), Limette als Akzent, Violett für Status. -->
    <style name="Theme.SleepTvOff" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/night</item>
        <item name="colorPrimaryContainer">@color/surface2</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="colorOnSecondary">@color/night</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Btn" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Btn.Accent">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/night</item>
    </style>

    <style name="Btn.Ink">
        <item name="backgroundTint">@color/night</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Btn.Tonal">
        <item name="backgroundTint">@color/surface2</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Btn.Accent2">
        <item name="backgroundTint">@color/accent2_container</item>
        <item name="android:textColor">@color/accent2</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
